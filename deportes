            return data;
        } catch (e) {
            clearTimeout(timeout);
            throw e;
        }
    }

    async function fetchMatches() {
        // 1) Try direct
        try {
            const data = await tryFetch(RAW_API);
            allMatches = data;
            buildFilters(allMatches);
            renderMatches(allMatches, currentFilter);
            console.log('✓ Loaded via direct API');
            return;
        } catch (e1) {
            console.warn('Direct failed:', e1.message);
        }

        // 2) Try proxies
        for (let i = 0; i < PROXIES.length; i++) {
            try {
                const data = await tryFetch(PROXIES[i] + encodeURIComponent(RAW_API));
                allMatches = data;
                buildFilters(allMatches);
                renderMatches(allMatches, currentFilter);
                console.log('✓ Loaded via proxy #' + (i + 1));
                return;
            } catch (e2) {
                console.warn('Proxy #' + (i + 1) + ' failed:', e2.message);
            }
        }

        // 3) All failed
        document.getElementById('matchesContainer').innerHTML =
            '<div class="no-matches">⚠️ No se pudieron cargar los partidos. Por favor, recarga la página.</div>';
    }

    function buildFilters(matches) {
        const sports = [...new Set(matches.map(m => m.Sport))].filter(Boolean).sort();
        const box = document.getElementById('filtersContainer');
        box.innerHTML = '';
        const mkBtn = (label, val) => {
            const b = document.createElement('button');
            b.className = 'filter-btn' + (currentFilter === val ? ' active' : '');
            b.textContent = label;
            b.dataset.filter = val;
            b.addEventListener('click', () => setFilter(val));
            box.appendChild(b);
        };
        mkBtn('Todos los deportes', 'all');
        sports.forEach(s => mkBtn(s, s));
    }

    function setFilter(val) {
        currentFilter = val;
        document.querySelectorAll('.filter-btn').forEach(b =>
            b.classList.toggle('active', b.dataset.filter === val)
        );
        renderMatches(allMatches, val);
    }

    function renderMatches(matches, filterSport) {
        const container = document.getElementById('matchesContainer');
        const filtered = filterSport === 'all' ? matches : matches.filter(m => m.Sport === filterSport);
        if (!filtered.length) {
            container.innerHTML = '<div class="no-matches">No hay partidos en esta categoría.</div>';
            return;
        }
        const map = new Map();
        filtered.forEach(m => {
            const league = m.League || 'Liga desconocida';
            if (!map.has(league)) {
                map.set(league, { name: league, logo: m.LeagueLogo || '', matches: [] });
            }
            map.get(league).matches.push(m);
        });
        const leagues = [...map.values()].sort((a, b) => a.name.localeCompare(b.name));

        let html = '';
        leagues.forEach(lg => {
            html += `<div class="league-section">`;
            html += `<div class="league-header">`;
            if (lg.logo) html += `<img src="${lg.logo}" alt="${escapeHtml(lg.name)}" onerror="this.style.display='none'">`;
            html += `<h2>${escapeHtml(lg.name)}</h2></div>`;
            lg.matches.sort((a, b) => {
                const da = new Date((a.MatchDate || '') + 'T' + (a.MatchStartTime || '00:00'));
                const db = new Date((b.MatchDate || '') + 'T' + (b.MatchStartTime || '00:00'));
                return da - db;
            });
            lg.matches.forEach(m => { html += cardHtml(m); });
            html += `</div>`;
        });
        container.innerHTML = html;
    }

    function cardHtml(m) {
        const t1 = escapeHtml(m.Team1 || 'Equipo 1');
        const t2 = escapeHtml(m.Team2 || 'Equipo 2');
        const l1 = m.Team1Logo || 'https://via.placeholder.com/50?text=?';
        const l2 = m.Team2Logo || 'https://via.placeholder.com/50?text=?';
        const time = escapeHtml(m.MatchStartTime || '--:--');
        const league = escapeHtml(m.League || '');

        const watchUrl = 'watch1.html'
            + '?team1=' + encodeURIComponent(m.Team1 || '')
            + '&team2=' + encodeURIComponent(m.Team2 || '')
            + '&logo1=' + encodeURIComponent(m.Team1Logo || '')
            + '&logo2=' + encodeURIComponent(m.Team2Logo || '')
            + '&time=' + encodeURIComponent(m.MatchStartTime || '')
            + '&date=' + encodeURIComponent(m.MatchDate || '')
            + '&league=' + encodeURIComponent(m.League || '')
            + '&leagueLogo=' + encodeURIComponent(m.LeagueLogo || '')
            + '&url=' + encodeURIComponent(m.IframeURL || '');

        return `
            <div class="match-card">
                <a href="${watchUrl}">
                    <div class="team">
                        <img src="${l1}" alt="${t1}" onerror="this.src='https://via.placeholder.com/50?text=?'">
                        <span>${t1}</span>
                    </div>
                    <div class="match-info">
                        <div class="match-time">${time}</div>
                        <div class="match-league-name">${league}</div>
                    </div>
                    <div class="team">
                        <img src="${l2}" alt="${t2}" onerror="this.src='https://via.placeholder.com/50?text=?'">
                        <span>${t2}</span>
                    </div>
                </a>
            </div>
        `;
    }

    function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    fetchMatches();
})();
</script>

